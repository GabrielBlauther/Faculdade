{
  "tasks": [
    {
      "type": "process",
      "label": "C/C++: gcc arquivo de build ativo",
      "command": "gcc",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c11",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "args": [
          "-fdiagnostics-color=always",
          "-std=c11",
          "-g",
          "${file}",
          "-o",
          "${fileDirname}/${fileBasenameNoExtension}.exe"
        ]
      }
    }
  ],
  "version": "2.0.0"
}
